{
   "action": {
      "default_icon": "assets/logo.png",
      "default_title": "Guardio"
   },
   "background": {
      "service_worker": "background.bundle.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content.bundle.js" ],
      "matches": [ "*://*.guard.io/*" ]
   }, {
      "js": [ "linksInjected.bundle.js" ],
      "matches": [ "*://*.mail.google.com/*" ]
   } ],
   "content_security_policy": {
      "extension_page": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
      "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; object-src 'self'"
   },
   "declarative_net_request": {
      "rule_resources": [  ]
   },
   "description": "Experience a cleaner, safer web.",
   "externally_connectable": {
      "matches": [ "*://*.guard.io/*" ]
   },
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "assets/icon/gradient.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Guardio Protection for Edge",
   "optional_host_permissions": [  ],
   "optional_permissions": [ "contentSettings", "history", "downloads" ],
   "permissions": [ "webRequest", "webRequestBlocking", "declarativeNetRequestWithHostAccess", "cookies", "management", "notifications", "tabs", "storage", "idle", "contextMenus", "scripting", "alarms" ],
   "short_name": "Guardio",
   "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
   "version": "26.8.2.4049",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "assets/installed.json", "injected.bundle.js", "permissionProxy.bundle.js", "permissionProxyDisabled.bundle.js", "uiInjected.bundle.js", "frame.html" ]
   } ]
}
